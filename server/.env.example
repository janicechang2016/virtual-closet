# Copy to .env for local dev; set the same keys as Railway Variables in prod.
# DATABASE_URL is auto-injected by Railway's Postgres plugin in prod.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/virtual_closet

# Auth — the shared secret the frontend sends as `Authorization: Bearer <APP_SECRET>`.
# Generate with: openssl rand -hex 24
APP_SECRET=change-me-to-a-long-random-string

# Budget hard-stop (USD). Mirrors genlog.py's cap. Raising it is a deliberate act.
BUDGET_CAP_USD=45

# Paid APIs — not called during the foundation phase, but read at startup.
FAL_KEY=
ANTHROPIC_API_KEY=

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=virtual-closet
