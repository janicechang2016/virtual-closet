{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 virtual-closet/scripts/export_static.py --out site",
  "outputDirectory": "site",
  "rewrites": [
    { "source": "/", "destination": "/app/carousel.html" },
    { "source": "/fitting-room", "destination": "/app/index.html" },
    { "source": "/classic", "destination": "/app/index.html" },
    { "source": "/stylist", "destination": "/app/stylist.html" },
    { "source": "/insights", "destination": "/app/insights.html" },
    { "source": "/galaxy", "destination": "/app/galaxy.html" },
    { "source": "/api/manifest", "destination": "/api/manifest.json" },
    { "source": "/api/insights", "destination": "/api/insights.json" },
    { "source": "/api/galaxy", "destination": "/api/galaxy.json" },
    { "source": "/api/stylist/suggest", "destination": "/api/stylist/suggest.json" }
  ]
}
